# =============================================================================
# Creatrend Backend — Environment Variables Reference
# =============================================================================
#
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
#
# DOCKER / COMPOSE ISOLATION
# ──────────────────────────
# Each environment (staging / production) must have its own .env file
# with distinct values for COMPOSE_PROJECT_NAME, HOST_PORT, DATABASE_URL,
# REDIS_URL, JWT_SECRET, JWT_REFRESH_SECRET, and CLOUDINARY_FOLDER_PREFIX.
#
# STAGING example:
#   COMPOSE_PROJECT_NAME=creatrend-staging
#   HOST_PORT=5001
#   NODE_ENV=staging
#   APP_ENV=staging
#
# PRODUCTION example:
#   COMPOSE_PROJECT_NAME=creatrend-production
#   HOST_PORT=5000
#   NODE_ENV=production
#   APP_ENV=production
#
# =============================================================================


# =============================================================================
# DOCKER / COMPOSE CONFIGURATION
# =============================================================================

# Controls the Docker Compose project name.
# Docker prefixes every container, network, and volume name with this value.
# This is the primary isolation mechanism between staging and production.
# Staging:    creatrend-staging
# Production: creatrend-production
COMPOSE_PROJECT_NAME=creatrend-staging

# Host port the backend is exposed on (bound to 127.0.0.1 only).
# Nginx proxies this port for the appropriate domain.
# Staging:    5001
# Production: 5000
HOST_PORT=5001


# =============================================================================
# CORE APPLICATION CONFIG
# =============================================================================

# Node.js environment (used by Sequelize CLI to select config block).
# Must match a key in config/config.js: development | staging | production
NODE_ENV=staging

# Application environment (used by CORS logic in index.js).
# Set to 'production' to enforce CORS_ORIGIN restrictions.
APP_ENV=staging

# Port the Express app listens on inside the container.
# Should always be 8080 inside Docker. HOST_PORT maps this to the host.
PORT=8080

# Toggle email sending. Set to false in staging to prevent accidental emails.
TOGGLE_EMAIL=false

# Frontend URL for CORS and email links
FRONTEND_URL=https://staging.creatrend.com

# Comma-separated origin(s) allowed by CORS when APP_ENV=production.
# In staging/development, CORS allows all origins (no restriction).
CORS_ORIGIN=https://staging.creatrend.com


# =============================================================================
# DATABASE CONFIGURATION (Neon PostgreSQL)
# =============================================================================
# Staging and production MUST use separate Neon databases.
# Never point staging at the production database.

DB_HOST=your-neon-staging-host.neon.tech
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_staging_db_name
DB_DIALECT=postgres

# Required for Neon (TLS). Always set to true for Neon deployments.
DB_SSL=true


# =============================================================================
# JWT & AUTH CONFIGURATION
# =============================================================================
# Use long, random, unique secrets per environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=your_staging_jwt_secret_64_chars_minimum
JWT_REFRESH_SECRET=your_staging_jwt_refresh_secret_64_chars_minimum
JWT_EXPIRES_IN=2d

# Auth0 (optional — used if Auth0 JWT validation is enabled)
AUTH0_DOMAIN=your_auth0_domain
AUTH0_AUDIENCE=your_auth0_audience


# =============================================================================
# EMAIL CONFIGURATION (Brevo)
# =============================================================================

EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_brevo_smtp_user
EMAIL_PASS=your_brevo_smtp_pass
EMAIL_FROM=noreply@creatrend.com
EMAIL_PROVIDER=brevo
VERIFICATION_CODE_TTL_MINUTES=2
PASSWORD_RESET_TTL_MINUTES=15
BREVO_API_KEY=your_brevo_api_key
APP_LOGO_URL=https://creatrend.co.za/assets/HeaderLogo-L_gF-ssU.svg
SUPPORT_EMAIL=support@creatrend.co.za


# =============================================================================
# CLOUD STORAGE — AWS S3 (Primary Storage) + ImageKit (Delivery CDN)
# =============================================================================
# Set STORAGE_PROVIDER to 's3' for new AWS S3 + ImageKit media pipeline.
# Set to 'cloudinary' for legacy Cloudinary pipeline.
STORAGE_PROVIDER=s3

# AWS S3 Configuration
# Region must be 'af-south-1' (AWS Cape Town)
AWS_REGION=af-south-1
AWS_S3_BUCKET=creatrend-media-staging
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ImageKit Delivery Endpoint (Environment-specific origin)
# Staging:    https://ik.imagekit.io/your_staging_imagekit_id
# Production: https://ik.imagekit.io/your_production_imagekit_id
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_endpoint_id

# CLOUD STORAGE — Cloudinary (Legacy — retained for existing asset compatibility)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER_PREFIX=creatrend/staging


# =============================================================================
# CHAT / REDIS CONFIGURATION
# =============================================================================

# Inside Docker: use the Redis service hostname, NOT localhost.
# The hostname 'redis' resolves to the Redis container within the same
# Compose project network. Each project has its own isolated network,
# so 'redis' always resolves to the correct environment's Redis.
#
# CORRECT:   redis://redis:6379
# INCORRECT: redis://localhost:6379  (won't work inside Docker)
# INCORRECT: redis://127.0.0.1:6379 (won't work inside Docker)
REDIS_URL=redis://redis:6379


# =============================================================================
# SOCIAL ACCOUNT CONFIGURATION
# =============================================================================

# Instagram OAuth
INSTA_APP_ID=your_insta_app_id
INSTA_APP_SECRET=your_insta_app_secret
# Callback URL must match your environment domain
INSTA_CALLBACK_URL=https://staging-api.creatrend.com/api/social/instagram/callback

# TikTok OAuth
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_CALLBACK_URL=https://staging-api.creatrend.com/api/social/tiktok/callback

# Encryption key for storing OAuth access tokens in the database.
# Must be a 32-byte hex string (64 hex characters).
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_64_hex_chars


# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================

ADMIN_EMAIL=admin@creatrend.com


# =============================================================================
# CONTACT US / INQUIRY NOTIFICATION CONFIGURATION
# =============================================================================

CONTACT_EMAIL_SALES=sales@creatrend.com
CONTACT_EMAIL_CAREERS=careers@creatrend.com
CONTACT_EMAIL_GENERAL=support@creatrend.com
ADMIN_CONTACT_EMAIL=contact-admin@creatrend.com


# =============================================================================
# CLOUDFLARE TURNSTILE CAPTCHA CONFIGURATION
# =============================================================================

# Set to true in production to enforce CAPTCHA on protected endpoints.
TURNSTILE_ENABLED=false

# Secret key from Cloudflare Turnstile Dashboard.
# Use the dummy always-pass key for staging if not testing Turnstile:
# 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Site key from Cloudflare Turnstile Dashboard (sent to frontend)
TURNSTILE_SITE_KEY=1x0000000000000000000000000000000AA

# Fail-open strategy when Turnstile API is unreachable.
# true  = allow request through (permissive — suitable for staging)
# false = reject with 503 (strict — recommended for production)
TURNSTILE_FAIL_OPEN=true

# Timeout in milliseconds for the Cloudflare siteverify API call
TURNSTILE_TIMEOUT_MS=5000


# =============================================================================
# HOMEPAGE CAROUSEL CONFIGURATION
# =============================================================================

# Set to false on staging if Cloudinary is over limit or not needed.
HOMEPAGE_REAL_CREATORS_ENABLED=true

# Shipping / PayFast
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox
PAYFAST_WEBHOOK_SECRET_PATH=
API_PUBLIC_URL=

# Shipping / Bob Go
BOBGO_API_URL=https://api.sandbox.bobgo.co.za/v2
BOBGO_API_TOKEN=
BOBGO_WEBHOOK_SECRET_PATH=

# Book a Call Configuration
BOOK_CALL_ADMIN_EMAIL=admin@creatrend.co.za

# User Feedback Configuration
USER_FEEDBACK_ADMIN_EMAIL=admin@creatrend.co.za
